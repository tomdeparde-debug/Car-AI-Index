<style>
*{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;}
body{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:linear-gradient(160deg,#0f172a,#1e293b);color:#e2e8f0;min-height:100%;}
input,select,textarea{-webkit-user-select:text;user-select:text;font:inherit;}
.app{padding:clamp(12px,4vw,24px);max-width:560px;margin:0 auto;}
header{margin-bottom:18px;}
header h1{margin:0;font-size:1.5rem;font-weight:700;letter-spacing:.2px;}
header p{margin:4px 0 0;color:#94a3b8;font-size:.92rem;}
.card{background:rgba(30,41,59,.85);border:1px solid rgba(148,163,184,.15);border-radius:18px;padding:18px;margin-bottom:16px;box-shadow:0 8px 24px rgba(0,0,0,.25);}
.step{font-size:.75rem;text-transform:uppercase;letter-spacing:1px;color:#38bdf8;font-weight:700;margin-bottom:6px;}
