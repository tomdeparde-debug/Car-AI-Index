<body>
<div class="app">
  <header>
    <h1>Fiche Auto</h1>
    <p>Tapez une marque et un modèle, recherchez la fiche sur Google</p>
  </header>

  <section class="card" id="stepBrand">
    <div class="step">Étape 1 sur 2</div>
    <h2>Quelle voiture ?</h2>
    <label for="brand">Marque</label>
    <input type="text" id="brand" placeholder="Ex : Peugeot, Renault, BMW…" autocomplete="off" autocapitalize="words">
    <label for="model">Modèle</label>
    <input type="text" id="model" placeholder="Ex : 208, Clio, Série 3…" autocomplete="off" autocapitalize="words">
    <label for="edition">Version ou édition (facultatif)</label>
    <input type="text" id="edition" placeholder="Ex : GT Line, Edition One…" autocomplete="off">
    <button class="btn google-btn" id="btnSearch">Rechercher sur Google</button>
    <div class="hint">La recherche s'ouvre dans Google pour trouver la fiche technique.</div>
  </section>

  <section class="card hidden" id="stepResult">
    <div class="step">Étape 2 sur 2</div>
    <div class="summary">
      <div>
        <div class="name" id="resName"></div>
        <div class="sub" id="resSub"></div>
      </div>
      <button class="btn ghost small" id="btnEdit">Modifier</button>
    </div>
    <div class="hint">Ouvrez les résultats Google ci-dessous pour consulter la fiche complète (prix, puissance, poids, motorisations).</div>
    <a class="btn google-btn google-row" id="btnOpenGoogle" href="#" target="_blank" rel="noopener">Ouvrir les résultats Google</a>
    <div class="note">Les chiffres doivent être vérifiés sur les sources officielles du constructeur.</div>
  </section>
</div>
<div class="toast" id="toast"></div>

<script>
const APP_STORAGE_KEY = 'app_1792171619123_657pt7ts';
window.APP_STORAGE_KEY = APP_STORAGE_KEY;
document.addEventListener('dblclick', e => e.preventDefault());

const $ = id => document.getElementById(id);
let state = { brand: "", model: "", edition: "" };

function toast(msg){
  const t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  clearTimeout(window.__tt);
  window.__tt = setTimeout(() => t.classList.remove("show"), 2400);
}

function loadState(){
  let s = null;
  try { s = JSON.parse(localStorage.getItem(APP_STORAGE_KEY + "_data")); } catch(e){}
  if(!s || typeof s !== "object" || Array.isArray(s)) s = {};
  return {
    brand: typeof s.brand === "string" ? s.brand : "",
    model: typeof s.model === "string" ? s.model : "",
    edition: typeof s.edition === "string" ? s.edition : ""
  };
}
function saveState(){
  try { localStorage.setItem(APP_STORAGE_KEY + "_data", JSON.stringify(state)); } catch(e){}
}

function showStep(which){
  $("stepBrand").classList.toggle("hidden", which !== "brand");
  $("stepResult").classList.toggle("hidden", which !== "result");
  window.scrollTo(0,0);
}

function buildQuery(){
  const parts = [state.brand, state.model];
  if(state.edition.trim()) parts.push(state.edition.trim());
  return parts.join(" ");
}

function googleUrl(){
  const q = buildQuery() + " fiche technique prix puissance poids motorisation";
  return "https://www.google.com/search?q=" + encodeURIComponent(q);
}

function renderResult(){
  $("resName").textContent = `${state.brand} ${state.model}`;
  $("resSub").textContent = state.edition.trim();
  $("btnOpenGoogle").href = googleUrl();
  showStep("result");
}

function runSearch(){
  const brand = $("brand").value.trim();
  const model = $("model").value.trim();
  if(!brand || !model){ toast("Indiquez au moins la marque et le modèle."); return; }
  state.brand = brand;
  state.model = model;
  state.edition = $("edition").value.trim();
  saveState();
  renderResult();
  window.open(googleUrl(), "_blank", "noopener");
}

function init(){
  const s = loadState();
  state = { ...state, ...s };
  $("brand").value = state.brand;
  $("model").value = state.model;
  $("edition").value = state.edition;

  $("btnSearch").addEventListener("click", runSearch);
  ["brand","model","edition"].forEach(id => {
    $(id).addEventListener("keydown", e => { if(e.key === "Enter") runSearch(); });
  });
  $("btnEdit").addEventListener("click", () => showStep("brand"));

  if(state.brand && state.model){
    renderResult();
  } else {
    showStep("brand");
  }
}

init();


// Android WebView focus crash prevention
document.addEventListener("focusin", function(e) {
    if (e.target.tagName === "INPUT" && (e.target.type === "time" || e.target.type === "date" || e.target.type === "datetime-local")) {
        setTimeout(() => e.target.blur(), 100);
    }
});

// Time picker functionality for Android compatibility
function showTimePicker(inputId) {
    const input = document.getElementById(inputId);
    if (!input) return;
    
    input.blur();
    document.activeElement.blur();
    
    // Simple time picker using prompt (can be enhanced with custom modal)
    const currentTime = input.value || "12:00";
    const newTime = prompt("Enter time (HH:MM):", currentTime);
    
    if (newTime && /^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/.test(newTime)) {
        input.value = newTime;
        input.dispatchEvent(new Event('change', { bubbles: true }));
    }
}

// Date picker functionality for Android compatibility  
function showDatePicker(inputId) {
    const input = document.getElementById(inputId);
    if (!input) return;
    
    input.blur();
    document.activeElement.blur();
    
    // Simple date picker using prompt (can be enhanced with custom modal)
    const currentDate = input.value || new Date().toISOString().split('T')[0];
    const newDate = prompt("Enter date (YYYY-MM-DD):", currentDate);
    
    if (newDate && /^\d{4}-\d{2}-\d{2}$/.test(newDate)) {
        input.value = newDate;
        input.dispatchEvent(new Event('change', { bubbles: true }));
    }
}
</script>
</body>
